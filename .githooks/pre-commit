#!/bin/sh
#
# Pre-commit hook: runs fast local validation before every commit.
# Install with: git config core.hooksPath .githooks
#
set -e

# Lint through uv so this hook, the pre-push hook, and CI all run the
# Ruff version pinned in uv.lock. A bare `ruff` resolves to whatever the
# machine happens to have, which is how a commit hook can pass on code
# that CI then rejects. Say so when uv is absent rather than failing a
# commit over a tool this repository does not install.
if command -v uv >/dev/null 2>&1; then
    echo "=== pre-commit: ruff check ==="
    uv run --locked ruff check scripts .github/scripts
    uv run --locked ty check scripts .github/scripts
else
    echo "=== pre-commit: uv not found, skipping lint ==="
    echo "Install uv to lint locally; CI always runs it." >&2
fi

echo "=== pre-commit: check portability ==="
python3 .github/scripts/check-portability.py

echo "=== pre-commit: validate skill structure ==="
python3 scripts/validate.py

echo "=== pre-commit: check expiry ==="
python3 scripts/check-expiry.py

echo "=== pre-commit: version consistency ==="
python3 scripts/check-version-consistency.py

echo "=== pre-commit: README tree ==="
python3 scripts/check-readme-tree.py
