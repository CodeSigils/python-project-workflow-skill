#!/bin/sh
#
# pre-push hook: the local gate for a direct push to main.
#
# GitHub branch protection is the authoritative gate: it requires the CI
# checks and blocks direct pushes, including administrator pushes. This hook
# provides faster local feedback before attempting a direct push to main.
#
# The checks below cover the local source-validation surface. CI remains the
# independent validation record for every merged change.
#
# Install with: git config core.hooksPath .githooks
#
set -eu

pushes_main=false
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        pushes_main=true
    fi
done

if [ "$pushes_main" = false ]; then
    exit 0
fi

failed=0

run() {
    label=$1
    shift
    printf '=== pre-push: %s ===\n' "$label"
    if "$@"; then
        return 0
    fi
    printf 'pre-push: FAILED %s\n' "$label" >&2
    failed=1
}

if command -v uv >/dev/null 2>&1; then
    run "ruff check" uv run --locked ruff check scripts .github/scripts
    run "type check" uv run --locked ty check scripts .github/scripts
else
    echo "=== pre-push: uv not found, skipping lint ==="
    echo "Install uv to lint locally; CI always runs it." >&2
fi

run "shell script lint" shellcheck scripts/*.sh .githooks/*
run "CI policy" python3 scripts/validate-ci.py
run "CI policy tests" python3 scripts/test-validate-ci.py
run "skill structure" python3 scripts/validate.py
run "cross-agent portability" python3 .github/scripts/check-portability.py
run "README tree" python3 scripts/check-readme-tree.py
run "version consistency" python3 scripts/check-version-consistency.py
run "freshness markers" python3 scripts/check-expiry.py
run "repo hygiene self-test" python3 scripts/check-repo-hygiene.py --self-test
run "payload sync tests" python3 scripts/test-sync-payload.py
run "payload drift" bash scripts/sync-payload.sh --ci
run "behavioral regression fixtures" python3 scripts/run-codex-regression.py --self-test
run "Hermes regression fixtures" python3 scripts/run-hermes-regression.py --self-test
run "behavioral regression grader" python3 scripts/grade-codex-regression.py --self-test

if [ "$failed" -ne 0 ]; then
    echo "" >&2
    echo "pre-push: verification failed. Fix the failures above and push again." >&2
    echo "Use --no-verify only if you accept that CI is now the only gate left." >&2
    exit 1
fi

echo "=== pre-push: OK ==="
